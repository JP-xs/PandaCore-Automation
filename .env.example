# =====================================================================
# Configuracion del Motor Core (feature/panda-core) - JPxs-LightPanda-AI
# =====================================================================
# Copie este archivo a `.env` y ajuste los valores segun el entorno.
# Nunca suba el archivo `.env` con claves reales al repositorio.
# =====================================================================

# ---------------------------------------------------------------------
# Lightpanda (Chrome DevTools Protocol)
# URL del navegador headless Lightpanda.
#   Desarrollo local (WSL2):  http://127.0.0.1:9222
#   Produccion OpenCloud:     http://<IP-OPENCLOUD>:9222
# ---------------------------------------------------------------------
LIGHTPANDA_URL=http://127.0.0.1:9222

# ---------------------------------------------------------------------
# Claves de API de los proveedores de IA
# Obtenlas en openai.com (OpenAI) y console.anthropic.com (Anthropic)
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-tu_clave_de_openai_aqui
ANTHROPIC_API_KEY=sk-ant-tu_clave_de_anthropic_aqui

# ---------------------------------------------------------------------
# Servidor del Motor Core (FastAPI)
# La UI (Worktree 2) se conecta por HTTP a CORE_API_HOST:CORE_API_PORT
# mediante la variable CORE_API_URL de su propio .env.
# ---------------------------------------------------------------------
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8000

# ---------------------------------------------------------------------
# Proveedor y modelo de IA por defecto
#   openai  -> GPT-4o-mini  (scraping masivo de software, economico)
#   anthropic -> Claude 3.5 Sonnet (analisis juridico profundo de tesis)
# ---------------------------------------------------------------------
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# Tiempo de espera y reintentos
# ---------------------------------------------------------------------
CDP_CONNECT_TIMEOUT=10
NAVIGATION_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=2
REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
