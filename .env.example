# =====================================================================
# Configuracion del Motor Core (feature/panda-core) - JPxs-LightPanda-AI
# =====================================================================
# Copie este archivo a `.env` y ajuste los valores segun el entorno.
# Nunca suba el archivo `.env` con claves reales al repositorio.
# =====================================================================

# ---------------------------------------------------------------------
# Lightpanda (Chrome DevTools Protocol)
# URL del navegador headless Lightpanda.
#   Desarrollo local (WSL2):  http://127.0.0.1:9222
#   Produccion OpenCloud:     http://<IP-OPENCLOUD>:9222
# ---------------------------------------------------------------------
LIGHTPANDA_URL=http://127.0.0.1:9222

# ---------------------------------------------------------------------
# OpenCode (unico proveedor de IA - API gratuita)
# Obten tu clave en OpenCode. Ejemplo: oc_sk_...
# ---------------------------------------------------------------------
OPENCODE_API_KEY=oc_sk_tu_clave_de_opencode_aqui
OPENCODE_BASE_URL=https://api.opencode.com/v1

# ---------------------------------------------------------------------
# Proveedor y modelo de IA por defecto (unicamente OpenCode)
# Modelos gratuitos disponibles:
#   nemotron-3.5-super-vl-2024-10-22  (por defecto)
#   beam-free
#   deepseek-v4.1-flash-free
#   nemotron-3.5-lightning-free
#   glm-5.3-flash-free
#   mimo-v2.6-flash-free
#   crouton-alpha-free
#   pulse-alpha-free
#   flint-40b-free
#   big-pickle
# ---------------------------------------------------------------------
DEFAULT_AI_PROVIDER=open_code
DEFAULT_AI_MODEL=nemotron-3.5-super-vl-2024-10-22

# ---------------------------------------------------------------------
# Servidor del Motor Core (FastAPI)
# La UI (Worktree 2) se conecta por HTTP a CORE_API_HOST:CORE_API_PORT
# mediante la variable CORE_API_URL de su propio .env.
# ---------------------------------------------------------------------
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8000

# ---------------------------------------------------------------------
# Tiempo de espera y reintentos
# ---------------------------------------------------------------------
CDP_CONNECT_TIMEOUT=10
NAVIGATION_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=2
REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
